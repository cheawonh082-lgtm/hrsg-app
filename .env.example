# 계산 엔진 / 레퍼런스 데이터 (PRD §4.4) — 실제 공식 입수 전에는 mock 유지
CALC_ENGINE=mock            # mock | real
DATA_SOURCE=mock            # mock | real
SECRETS_DIR=../secrets

# LLM — fake(규칙 기반, 결정적) | gemini(Google AI Studio) | claude(Anthropic). gemini·claude는 LLM_API_KEY 필요
# 키는 이 파일이 아니라 .env(Git 제외)에만 넣는다
#   gemini: https://aistudio.google.com → Get API key
#   claude: https://platform.claude.com → API Keys
LLM_PROVIDER=fake           # fake | gemini | claude
LLM_MODEL=                  # 비우면 gemini-3.5-flash / claude-sonnet-5-5
LLM_FALLBACK_MODELS=        # gemini 전용: 과부하·한도 초과 시 차례로 시도할 모델(쉼표 구분)
LLM_API_KEY=
LOG_PROMPTS=false

# RAG 문서 — DOCS_MASKED_DIR에 인제스트 결과가 있으면 실제 문서, 없으면 내장 Mock 문서 사용
# 실제 문서: DOCS_RAW_DIR에 넣고 `python -m app.rag.ingest` (README "실제 문서 넣기")
DOCS_RAW_DIR=../data/docs_raw
DOCS_MASKED_DIR=../data/docs_masked
# keyword: 위 문서 키워드 검색 / api: 논문 RAG 검색 API (hrsg-explorer-rag: uvicorn api.app:app --port 8100)
RAG_RETRIEVER=keyword
RAG_API_URL=http://127.0.0.1:8100
RAG_API_METHOD=4          # 1 bge+BM25 · 2 qwen+BM25 · 3 bge+qwen+BM25 · 4 3안+질문 언어별 가중 RRF
RAG_API_TOP_N=5

# 체크리스트 체크 상태·메모 저장 파일 (Git 제외)
CHECKLIST_STATE_PATH=../data/checklist_state.json

# 서버 (로컬 바인딩 유지, PRD §5)
HOST=127.0.0.1
PORT=8000

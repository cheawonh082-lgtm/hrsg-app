# 계산 엔진 / 레퍼런스 데이터 (PRD §4.4) — 실제 공식 입수 전에는 mock 유지
CALC_ENGINE=mock            # mock | real
DATA_SOURCE=mock            # mock | real
SECRETS_DIR=../secrets

# LLM (3주차부터 사용)
LLM_PROVIDER=fake           # claude | fake | local
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=
VECTOR_DB_DIR=../data/vectordb
LOG_PROMPTS=false

# 서버 (로컬 바인딩 유지, PRD §5)
HOST=127.0.0.1
PORT=8000
